{
  "_key": "cs-initial-access",
  "name": "Initial Access via SCP/SSH",
  "description": "Copy beacon payload to target via SCP then execute via SSH",
  "icon": "\ud83d\udeaa",
  "tactic": "TA0001",
  "category": "Cobalt Strike",
  "subcategory": "Initial Access",
  "riskLevel": "High",
  "estimatedDuration": 60,
  "executionType": "cobalt_strike",
  "robotKeyword": "Initial Access",
  "robotTemplate": "Initial Access    ${target_ip}    ${username}    ${password}    ${local_beacon_path}",
  "inputs": [
    {
      "id": "payload",
      "label": "Payload / Prior Step",
      "type": "C2_Server",
      "required": false
    }
  ],
  "outputs": [
    {
      "id": "session",
      "label": "Beacon Session",
      "type": "Agent_Session"
    }
  ],
  "parameters": [
    {
      "id": "target_ip",
      "label": "Target IP",
      "type": "string",
      "required": true,
      "placeholder": "172.16.2.5"
    },
    {
      "id": "username",
      "label": "Username",
      "type": "string",
      "required": true,
      "placeholder": "Administrator"
    },
    {
      "id": "password",
      "label": "Password",
      "type": "string",
      "required": true,
      "placeholder": "P@ssw0rd"
    },
    {
      "id": "local_beacon_path",
      "label": "Local Beacon Path",
      "type": "string",
      "required": true,
      "placeholder": "${WORKDIR}update.exe",
      "default": "${WORKDIR}update.exe"
    }
  ],
  "requirements": {
    "c2Server": true,
    "listeners": [
      "HTTP"
    ]
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py",
      "SCPLibrary",
      "SSHLibrary"
    ],
    "keyword": "Initial Access",
    "keywordArgs": [
      {
        "position": 1,
        "param": "target_ip"
      },
      {
        "position": 2,
        "param": "username"
      },
      {
        "position": 3,
        "param": "password"
      },
      {
        "position": 4,
        "param": "local_beacon_path"
      }
    ],
    "variables": [],
    "preKeywordLog": "Establishing initial access"
  }
}