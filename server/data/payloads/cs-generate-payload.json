{
  "_key": "cs-generate-payload",
  "name": "Generate Payload",
  "description": "Generate a Cobalt Strike beacon payload bound to a listener",
  "icon": "\ud83d\udca3",
  "tactic": "TA0042",
  "category": "Cobalt Strike",
  "subcategory": "Infrastructure",
  "riskLevel": "High",
  "estimatedDuration": 30,
  "executionType": "cobalt_strike",
  "robotKeyword": "Create Payload",
  "robotTemplate": "${payload_path}=    Create Payload    ${payload_name}    ${payload_template}    ${listener_name}    ${workdir}    ${retries}",
  "inputs": [
    {
      "id": "c2_server",
      "label": "C2 Server",
      "type": "C2_Server",
      "required": false
    }
  ],
  "outputs": [
    {
      "id": "payload_path",
      "label": "Payload File Path",
      "type": "string"
    }
  ],
  "parameters": [
    {
      "id": "payload_name",
      "label": "Payload Name",
      "type": "string",
      "required": true,
      "placeholder": "update",
      "default": "update"
    },
    {
      "id": "payload_template",
      "label": "Template",
      "type": "select",
      "required": true,
      "options": [
        "exe",
        "dll",
        "shellcode",
        "ps1"
      ],
      "default": "exe"
    },
    {
      "id": "listener_name",
      "label": "Listener",
      "type": "string",
      "required": true,
      "placeholder": "HTTP",
      "default": "HTTP"
    },
    {
      "id": "workdir",
      "label": "Output Directory",
      "type": "string",
      "required": true,
      "placeholder": "${WORKDIR}",
      "default": "${WORKDIR}"
    },
    {
      "id": "retries",
      "label": "Retries",
      "type": "number",
      "required": false,
      "default": 5
    }
  ],
  "requirements": {
    "c2Server": true,
    "listeners": [
      "HTTP"
    ]
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py"
    ],
    "keyword": "Create Payload",
    "captureOutput": "PAYLOAD_PATH",
    "keywordArgs": [
      {
        "position": 1,
        "param": "payload_name"
      },
      {
        "position": 2,
        "param": "payload_template"
      },
      {
        "position": 3,
        "param": "listener_name"
      },
      {
        "position": 4,
        "param": "workdir"
      },
      {
        "position": 5,
        "param": "retries"
      }
    ],
    "variables": [],
    "preKeywordLog": "Generating payload",
    "postKeywordLog": "Payload generated: ${PAYLOAD_PATH}"
  }
}