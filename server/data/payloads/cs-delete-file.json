  "inputs": [
    {
      "id": "session",
      "label": "Beacon Session",
      "type": "Agent_Session",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "session",
      "label": "Session",
      "type": "Agent_Session"
    }
  ],
  "parameters": [
    {
      "id": "session",
      "label": "Session",
      "type": "string",
      "required": true,
      "placeholder": "${session}"
    },
    {
      "id": "filename",
      "label": "File Path",
      "type": "string",
      "required": true,
      "placeholder": "C:\\Windows\\Temp\\tmp.zip"
    }
  ],
  "requirements": {
    "c2Server": true
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py"
    ],
    "keyword": "Delete File",
    "keywordArgs": [
      {
        "position": 1,
        "sessionVariable": "CURRENT_SESSION"
      },
      {
        "position": 2,
        "param": "filename"
      }
    ],
    "variables": [],
    "preKeywordLog": "Deleting file"
  }
