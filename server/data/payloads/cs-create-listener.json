{
  "_key": "cs-create-listener",
  "name": "Create Listener",
  "description": "Create an HTTP, HTTPS, or SMB listener on the Cobalt Strike teamserver",
  "icon": "\ud83d\udce1",
  "tactic": "TA0011",
  "category": "Cobalt Strike",
  "subcategory": "Infrastructure",
  "riskLevel": "Medium",
  "estimatedDuration": 20,
  "executionType": "cobalt_strike",
  "robotKeyword": "Create Listener",
  "robotTemplate": "Create Listener    ${listener_name}    ${listener_port}    ${listener_type}    ${cs_ip}",
  "inputs": [
    {
      "id": "c2_server",
      "label": "C2 Server",
      "type": "C2_Server",
      "required": false
    }
  ],
  "outputs": [
    {
      "id": "listener",
      "label": "C2 Listener",
      "type": "Agent_Session"
    }
  ],
  "parameters": [
    {
      "id": "listener_name",
      "label": "Listener Name",
      "type": "string",
      "required": true,
      "placeholder": "HTTP",
      "default": "HTTP"
    },
    {
      "id": "listener_port",
      "label": "Port",
      "type": "number",
      "required": true,
      "placeholder": "80",
      "default": 80
    },
    {
      "id": "listener_type",
      "label": "Type",
      "type": "select",
      "required": true,
      "options": [
        "Beacon_HTTP",
        "Beacon_HTTPS",
        "Beacon_SMB"
      ],
      "default": "Beacon_HTTP"
    },
    {
      "id": "cs_ip",
      "label": "CS Team Server IP",
      "type": "string",
      "required": true,
      "placeholder": "${CS_IP}",
      "default": "${CS_IP}"
    }
  ],
  "requirements": {
    "c2Server": true
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py"
    ],
    "keyword": "Create Listener",
    "keywordArgs": [
      {
        "position": 1,
        "param": "listener_name"
      },
      {
        "position": 2,
        "param": "listener_port"
      },
      {
        "position": 3,
        "param": "listener_type"
      },
      {
        "position": 4,
        "globalSetting": "CS_IP"
      }
    ],
    "variables": [
      {
        "name": "LISTENER_NAME",
        "fromParam": "listener_name",
        "scope": "suite",
        "default": "HTTP"
      }
    ],
    "preKeywordLog": "Creating listener: ${LISTENER_NAME}"
  }
}