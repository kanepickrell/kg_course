{
  "_key": "cs-list-directory",
  "name": "List Directory",
  "description": "List contents of a directory on target via beacon",
  "icon": "\ud83d\udcc1",
  "tactic": "TA0007",
  "category": "Cobalt Strike",
  "subcategory": "Discovery",
  "riskLevel": "Low",
  "estimatedDuration": 5,
  "executionType": "cobalt_strike",
  "robotKeyword": "list directory",
  "robotTemplate": "${output}=    Issue Shell Cmd    ${session}    dir ${directory}",
  "shellCommand": "dir ${directory}",
  "inputs": [
    {
      "id": "session",
      "label": "Beacon Session",
      "type": "Agent_Session",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "session",
      "label": "Session",
      "type": "Agent_Session"
    }
  ],
  "parameters": [
    {
      "id": "session",
      "label": "Session",
      "type": "string",
      "required": true,
      "placeholder": "${session}"
    },
    {
      "id": "directory",
      "label": "Directory Path",
      "type": "string",
      "required": false,
      "placeholder": "C:\\Users\\Administrator\\Downloads",
      "default": "."
    }
  ],
  "requirements": {
    "c2Server": true
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py"
    ],
    "keyword": "Issue Shell Cmd",
    "captureOutput": "DIR_LISTING",
    "keywordArgs": [
      {
        "position": 1,
        "sessionVariable": "CURRENT_SESSION"
      },
      {
        "position": 2,
        "param": "directory"
      }
    ],
    "variables": [],
    "preKeywordLog": "Listing directory"
  }
}