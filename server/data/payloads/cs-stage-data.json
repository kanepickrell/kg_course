{
  "_key": "cs-stage-data",
  "name": "Stage Data",
  "description": "Archive target files using PowerShell Compress-Archive for exfiltration",
  "icon": "\ud83d\udce6",
  "tactic": "TA0009",
  "category": "Cobalt Strike",
  "subcategory": "Collection",
  "riskLevel": "High",
  "estimatedDuration": 30,
  "executionType": "cobalt_strike",
  "robotKeyword": "Stage Data",
  "robotTemplate": "${output}=    Issue Powershell Cmd    ${session}    Compress-Archive -Path ${source_directory} -DestinationPath ${destination}",
  "inputs": [
    {
      "id": "session",
      "label": "Beacon Session",
      "type": "Agent_Session",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "session",
      "label": "Session",
      "type": "Agent_Session"
    }
  ],
  "parameters": [
    {
      "id": "session",
      "label": "Session",
      "type": "string",
      "required": true,
      "placeholder": "${session}"
    },
    {
      "id": "source_directory",
      "label": "Source Path",
      "type": "string",
      "required": true,
      "placeholder": "C:\\Users\\Administrator\\Documents\\*.jpg"
    },
    {
      "id": "destination",
      "label": "Destination Archive",
      "type": "string",
      "required": true,
      "placeholder": "C:\\Windows\\Temp\\tmp.zip"
    }
  ],
  "requirements": {
    "c2Server": true
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py"
    ],
    "keyword": "Stage Data",
    "captureOutput": "STAGE_RESULT",
    "keywordArgs": [
      {
        "position": 1,
        "sessionVariable": "CURRENT_SESSION"
      },
      {
        "position": 2,
        "param": "source_directory"
      },
      {
        "position": 3,
        "param": "destination"
      }
    ],
    "variables": [],
    "preKeywordLog": "Staging data for exfiltration"
  }
