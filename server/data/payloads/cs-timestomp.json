  "icon": "\ud83d\udd50",
  "tactic": "TA0005",
  "category": "Cobalt Strike",
  "subcategory": "Defense Evasion",
  "riskLevel": "Medium",
  "estimatedDuration": 5,
  "executionType": "cobalt_strike",
  "robotKeyword": "Run Btimestomp",
  "robotTemplate": "Run Btimestomp    ${session}    ${target_file}    ${reference_file}",
  "inputs": [
    {
      "id": "session",
      "label": "Beacon Session",
      "type": "Agent_Session",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "session",
      "label": "Session",
      "type": "Agent_Session"
    }
  ],
  "parameters": [
    {
      "id": "session",
      "label": "Session",
      "type": "string",
      "required": true,
      "placeholder": "${session}"
    },
    {
      "id": "target_file",
      "label": "File to Modify",
      "type": "string",
      "required": true,
      "placeholder": "C:\\inetpub\\wwwroot\\http.php"
