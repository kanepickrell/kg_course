{
  "_key": "cs-delete-file",
  "name": "Delete File",
  "description": "Delete a file on target via beacon to remove artifacts and cover tracks",
  "icon": "\ud83d\uddd1\ufe0f",
  "tactic": "TA0005",
  "category": "Cobalt Strike",
  "subcategory": "Defense Evasion",
  "riskLevel": "Medium",
  "estimatedDuration": 5,
  "executionType": "cobalt_strike",
  "robotKeyword": "Delete File",
  "robotTemplate": "${output}=    Issue Shell Cmd    ${session}    del /f ${filename}",
