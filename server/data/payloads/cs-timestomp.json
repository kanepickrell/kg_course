    {
      "id": "reference_file",
      "label": "Reference File",
      "type": "string",
      "required": true,
      "placeholder": "C:\\inetpub\\wwwroot\\index.html"
    }
  ],
  "requirements": {
    "c2Server": true
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py"
    ],
    "keyword": "Run Btimestomp",
    "keywordArgs": [
      {
        "position": 1,
        "sessionVariable": "CURRENT_SESSION"
      },
      {
        "position": 2,
        "param": "target_file"
      },
      {
        "position": 3,
        "param": "reference_file"
      }
    ],
    "variables": [],
    "preKeywordLog": "Timestomping ${target_file}"
  }
