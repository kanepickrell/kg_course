# =====================================================
# ARANGODB CONFIGURATION
# =====================================================
ARANGO_HOST=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=devpass
ARANGO_DB=AUTO_DB
ARANGO_GRAPH=protograph_kg

# =====================================================
# GRAPH_DB CONFIGURATION
# =====================================================
GRAPHDB_ENABLED=True

# =====================================================
# OLLAMA LLM CONFIGURATION
# =====================================================
OLLAMA_HOST=http://10.10.80.99:4001

# Model for meta-level reasoning (classification, aggregation)
OLLAMA_MODEL_META=gpt-oss:120b

# Model for fast binary classification (Stage 1 & 3 of discovery)
OLLAMA_MODEL_FAST=gemma3:27b-it-qat

# Model for deep reasoning (Stage 2 edge classification)
OLLAMA_MODEL_REASONING=llama3.3:70b

# Legacy single model env var (kept for backwards compatibility)
OLLAMA_MODEL=gpt-oss:120b

# =====================================================
# API CONFIGURATION
# =====================================================
API_HOST=0.0.0.0
API_PORT=8000
PAYLOAD_STORAGE_DIR=./data/payloads

# =====================================================
# FRONTEND CONFIGURATION
# =====================================================
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# =====================================================
# LLM DISCOVERY CONFIGURATION
# =====================================================
# Minimum confidence threshold (1-10) for suggesting edges
LLM_DISCOVERY_THRESHOLD=7

# Whether to auto-trigger discovery after node ingestion
LLM_DISCOVERY_AUTO_TRIGGER=true

# Maximum node pairs to analyze in one batch (prevents memory issues)
LLM_DISCOVERY_MAX_PAIRS=1000

