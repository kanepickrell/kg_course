{
  "_key": "cs-stop-service",
  "name": "Stop Service",
  "description": "Stop a named Windows service via net stop command through beacon",
  "icon": "\u26d4",
  "tactic": "TA0009",
  "category": "Cobalt Strike",
  "subcategory": "Impact",
  "riskLevel": "High",
  "estimatedDuration": 10,
  "executionType": "cobalt_strike",
  "robotKeyword": "Stop Service",
  "robotTemplate": "${output}=    Issue Shell Cmd    ${session}    net stop ${service_name}",
  "shellCommand": "net stop ${service_name}",
  "inputs": [
    {
      "id": "session",
      "label": "Beacon Session",
      "type": "Agent_Session",
      "required": true
    }
  ],
  "outputs": [
    {
      "id": "session",
      "label": "Session",
      "type": "Agent_Session"
    }
  ],
  "parameters": [
    {
      "id": "session",
      "label": "Session",
      "type": "string",
      "required": true,
      "placeholder": "${session}"
    },
    {
      "id": "service_name",
      "label": "Service Name",
      "type": "string",
      "required": true,
      "placeholder": "MSSQLSERVER"
    }
  ],
  "requirements": {
    "c2Server": true
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py"
    ],
    "keyword": "Issue Shell Cmd",
    "captureOutput": "SVC_RESULT",
    "keywordArgs": [
      {
        "position": 1,
        "sessionVariable": "CURRENT_SESSION"
      },
      {
        "position": 2,
        "param": "service_name"
      }
    ],
    "variables": [],
    "preKeywordLog": "Stopping service: ${service_name}"
  }
}