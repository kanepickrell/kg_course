{
  "_key": "cs-get-session-by-ip",
  "name": "Get Session By IP",
  "description": "Retrieve active beacon sessions for a target IP from the teamserver",
  "icon": "\ud83d\udd0c",
  "tactic": "TA0011",
  "category": "Cobalt Strike",
  "subcategory": "Session Management",
  "riskLevel": "Low",
  "estimatedDuration": 10,
  "executionType": "cobalt_strike",
  "robotKeyword": "Get Sessions By Ip",
  "robotTemplate": "@{sessions}=    Get Sessions By Ip    ${target_ip}\n${session}=    SET VARIABLE    ${sessions[0]}",
  "inputs": [
    {
      "id": "c2_server",
      "label": "C2 Server / Prior Step",
      "type": "C2_Server",
      "required": false
    }
  ],
  "outputs": [
    {
      "id": "session",
      "label": "Beacon Session",
      "type": "Agent_Session"
    }
  ],
  "parameters": [
    {
      "id": "target_ip",
      "label": "Target IP",
      "type": "string",
      "required": true,
      "placeholder": "172.16.2.5"
    }
  ],
  "requirements": {
    "c2Server": true
  },
  "robotFramework": {
    "libraries": [
      "cobaltstrikec2/cobaltstrike.py"
    ],
    "keyword": "Get Sessions By Ip",
    "captureOutput": "SESSIONS",
    "captureOutputAsList": true,
    "keywordArgs": [
      {
        "position": 1,
        "param": "target_ip"
      }
    ],
    "postKeywordStatements": [
      "${CURRENT_SESSION}=    SET VARIABLE    ${SESSIONS[0]}"
    ],
    "sessionVariable": "CURRENT_SESSION",
    "variables": [],
    "preKeywordLog": "Getting beacon session",
    "postKeywordLog": "Session acquired"
  }
}